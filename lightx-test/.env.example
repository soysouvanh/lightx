# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# The SQLx compiler requires this URL during the `cargo build` phase.
# It is used for database introspection and to validate `query!()` macros 
# at compile-time, ensuring absolute type-safety.
# Ensure this database is running and accessible before building the project.
DATABASE_URL=mysql://myuser:mypassword@localhost/mydatabase

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Defines the directory where the application will output its log files.
# In a local workspace, './log/' is preferred.
# For production server environments, you might want to use: /var/log/lightx
LIGHTX_LOG_DIR=./log/

# Specifies the language used for the framework's internal log messages (e.g., 'fr', 'en').
LIGHTX_LOG_LANG=en

# ==============================================================================
# ARCHITECTURE DIRECTORIES (CODE GENERATION)
# ==============================================================================
# LightX enforces a strict 'Database-First' architecture via generation.
# These environmental paths dictate where the framework reads and writes 
# its structural configurations. They are created automatically on build.

# 1. SCHEMA DIRECTORY
# Auto-generated Single Source of Truth from the database introspection.
# ⚠️ WARNING: DO NOT manually edit files here; they are overwritten every build!
LIGHTX_SCHEMA_DIR=./schema/

# 2. I18N DIRECTORY
# Externalized translation dictionaries for zero-overhead runtime translations.
# Structured geographically by language and bounded contexts (e.g. en/schema.toml).
LIGHTX_I18N_DIR=./i18n/

# 3. OVERRIDES DIRECTORY
# Safe space for developers to override the default introspection behaviors.
# Write your custom TOML rules here to redefine types or inject business logic.
LIGHTX_OVERRIDES_DIR=./overrides/

# ==============================================================================
# DOCUMENTATION GENERATION (SCAFFOLDING)
# ==============================================================================
# Enables whether the build script should generate pedagogical README files in
# their respective directories during compilation. Default is true.
LIGHTX_SCHEMA_README=true
LIGHTX_I18N_README=true
LIGHTX_OVERRIDES_README=true
LIGHTX_LOG_README=true